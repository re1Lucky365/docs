    def inspect_and_filter(self, raw_record: Dict[str, Any]) -> Tuple[bool, str]:
        """
        Evaluates incoming data using schema validation and content integrity checks.
        Returns (is_valid, reason).
        """
        # Step 1: Check for basic required structure
